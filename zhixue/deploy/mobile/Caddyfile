{
	admin off
	log {
		exclude http.log.access http.log.error http.handlers.reverse_proxy
	}
}

{$ZHIXUE_PHONE_HOST} {
	encode zstd gzip
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}
	header /mobile/* Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	redir / /mobile/ 302

	@phone path /mobile /mobile/* /assets/* /zhixue.png
	handle @phone {
		root * ./site
		file_server
	}
	handle {
		respond 404
	}
}

{$ZHIXUE_RELAY_HOST} {
	header Cache-Control "no-store"
	@relay path /healthz /v1/*
	handle @relay {
		reverse_proxy 127.0.0.1:{$ZHIXUE_RELAY_PORT:3221} {
			transport http {
				response_header_timeout 20s
			}
		}
	}
	handle {
		respond 404
	}
}
