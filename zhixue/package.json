{
  "name": "zhixue-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "desktop:electron": "electron desktop/electron.cjs",
    "desktop:package": "npm run build && node desktop/package.mjs",
    "mobile:package": "npm run build && uv run --no-project --python 3.11 python deploy/mobile/package.py",
    "desktop:qualify:windows": "node desktop/windows-qualify.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code-block": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-mathematics": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "katex": "0.18.10",
    "lucide-react": "^0.577.0",
    "marked": "17.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "43.8.12",
    "electron-builder": "26.18.0",
    "mdast-util-from-markdown": "2.1.0",
    "micromark-util-types": "2.0.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "$katex"
    },
    "app-builder-lib": {
      "minimatch@10.2.6": "11.0.9",
      "@electron/universal": "3.0.4"
    }
  }
}
